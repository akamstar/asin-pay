# Copier ce fichier en .env avant de lancer `docker compose up`.

# ---------------------------------------------------------------
# Service de paiement simulé (payement)
# ---------------------------------------------------------------
PAYMENT_PORT=8080
# Clé partagée : le backend l'envoie dans l'en-tête X-Api-Key
PAYMENT_API_KEY=dev-api-key-a-changer
PAYMENT_WEBHOOK_URL=http://backend:8000/api/v1/webhooks/paiement
# Délai de traitement aléatoire entre MIN et MAX (format Go : 500ms, 3s, 1m)
PAYMENT_MIN_DELAY=3s
PAYMENT_MAX_DELAY=10s
PAYMENT_WEBHOOK_MAX_ATTEMPTS=3
PAYMENT_WEBHOOK_BACKOFF=1s

# Paire de clés Ed25519 de DÉVELOPPEMENT UNIQUEMENT.
# Pour en générer une nouvelle : cd payement && go run ./cmd/keygen
PAYMENT_SIGNING_KEY_ID=payement-dev
PAYMENT_SIGNING_PRIVATE_KEY=0BoUzHGvxiYg/BLEm21iA4IykeoWsRrOtfupGnbE6XA=
# Clé publique correspondante, utilisée par le backend pour vérifier les signatures
PAYMENT_SIGNING_PUBLIC_KEY=z0wa3lkpTOy0ikQfF/DZlHvyl438b6XIyU1DenD2Opo=
