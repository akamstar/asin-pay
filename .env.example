# Copier ce fichier en .env avant de lancer `docker compose up`.
# Les valeurs ci-dessous sont des valeurs de DÉVELOPPEMENT.

# ---------------------------------------------------------------
# Backend Laravel
# ---------------------------------------------------------------
BACKEND_PORT=8000
APP_URL=http://localhost:8000
APP_DEBUG=false
# Pour en générer une nouvelle : docker compose run --rm backend php artisan key:generate --show
APP_KEY=base64:ufP7w38CzpuqL6F3kfHn2sT5BTiwe916Hrszn3ratuo=

# Frais de dossier (FCFA) ajoutés à chaque demande, et quantité maximale par demande
FRAIS_DOSSIER=100
DEMANDE_QUANTITE_MAX=10

# ---------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------
# Port exposé sur la machine hôte (5433 pour ne pas entrer en conflit avec un PostgreSQL local)
DB_FORWARD_PORT=5433
DB_DATABASE=backend
DB_USERNAME=asin
DB_PASSWORD=secret

# ---------------------------------------------------------------
# Service de paiement simulé (payement)
# ---------------------------------------------------------------
PAYMENT_PORT=8080
# Clé partagée : le backend l'envoie dans l'en-tête X-Api-Key
PAYMENT_API_KEY=dev-api-key-a-changer
PAYMENT_WEBHOOK_URL=http://backend:8080/api/v1/webhooks/paiement
# Délai de traitement aléatoire entre MIN et MAX (format Go : 500ms, 3s, 1m)
PAYMENT_MIN_DELAY=3s
PAYMENT_MAX_DELAY=10s
PAYMENT_WEBHOOK_MAX_ATTEMPTS=3
PAYMENT_WEBHOOK_BACKOFF=1s
# Côté backend : délai (secondes) avant de réconcilier un paiement resté en cours
PAYMENT_RECONCILE_AFTER=120

# Paire de clés Ed25519 de DÉVELOPPEMENT UNIQUEMENT.
# Pour en générer une nouvelle : cd payement && go run ./cmd/keygen
PAYMENT_SIGNING_KEY_ID=payement-dev
PAYMENT_SIGNING_PRIVATE_KEY=0BoUzHGvxiYg/BLEm21iA4IykeoWsRrOtfupGnbE6XA=
# Clé publique correspondante, utilisée par le backend pour vérifier les signatures
PAYMENT_SIGNING_PUBLIC_KEY=z0wa3lkpTOy0ikQfF/DZlHvyl438b6XIyU1DenD2Opo=
